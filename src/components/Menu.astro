---

<section id="menu" class="px-8 md:px-16 py-16 bg-black border-b border-[#111]">
  <div class="text-fire text-[9px] tracking-[4px] uppercase mb-4">— Menu</div>
  <h2 class="font-serif font-black text-white text-2xl md:text-3xl mb-12">What We Bring</h2>

  <!-- SPECIALTY PIZZA -->
  <div class="mb-12">
    <div class="flex items-center gap-4 mb-4">
      <h3 class="text-fire text-[10px] tracking-[3px] uppercase font-sans shrink-0">Specialty Pizza</h3>
      <div class="flex-1 h-px bg-[#1a1a1a]"></div>
    </div>
    <div class="grid grid-cols-[1fr_auto_auto_auto] gap-x-4 mb-2">
      <div></div>
      <div class="text-[#333] text-[9px] tracking-[1px] uppercase text-right">SM/10"</div>
      <div class="text-[#333] text-[9px] tracking-[1px] uppercase text-right">MED/14"</div>
      <div class="text-[#333] text-[9px] tracking-[1px] uppercase text-right">LG/16"</div>
    </div>
    {specialtyPizzas.map((item) => (
      <div class="grid grid-cols-[1fr_auto_auto_auto] gap-x-4 py-2 border-b border-[#0f0f0f]">
        <div>
          <div class="text-white text-xs font-bold tracking-wide">{item.name}</div>
          {item.desc && <div class="text-[#444] text-[10px] mt-0.5">{item.desc}</div>}
        </div>
        <div class="text-[#888] text-xs text-right self-center">{item.sm}</div>
        <div class="text-[#888] text-xs text-right self-center">{item.med}</div>
        <div class="text-[#888] text-xs text-right self-center">{item.lg}</div>
      </div>
    ))}
  </div>

  <!-- PIZZA -->
  <div class="mb-12">
    <div class="flex items-center gap-4 mb-4">
      <h3 class="text-fire text-[10px] tracking-[3px] uppercase font-sans shrink-0">Pizza</h3>
      <div class="flex-1 h-px bg-[#1a1a1a]"></div>
    </div>
    <div class="grid grid-cols-[1fr_auto_auto_auto] gap-x-4 mb-2">
      <div></div>
      <div class="text-[#333] text-[9px] tracking-[1px] uppercase text-right">SM</div>
      <div class="text-[#333] text-[9px] tracking-[1px] uppercase text-right">MED</div>
      <div class="text-[#333] text-[9px] tracking-[1px] uppercase text-right">LG</div>
    </div>
    {pizzaBase.map((item) => (
      <div class="grid grid-cols-[1fr_auto_auto_auto] gap-x-4 py-2 border-b border-[#0f0f0f]">
        <div>
          <div class="text-white text-xs font-bold tracking-wide">{item.name}</div>
          {item.desc && <div class="text-[#444] text-[10px] mt-0.5">{item.desc}</div>}
        </div>
        <div class="text-[#888] text-xs text-right self-center">{item.sm}</div>
        <div class="text-[#888] text-xs text-right self-center">{item.med}</div>
        <div class="text-[#888] text-xs text-right self-center">{item.lg}</div>
      </div>
    ))}
    <div class="text-[#333] text-[9px] tracking-[2px] uppercase mt-4 mb-2">Toppings (per topping)</div>
    {pizzaToppings.map((item) => (
      <div class="grid grid-cols-[1fr_auto_auto_auto] gap-x-4 py-2 border-b border-[#0f0f0f]">
        <div>
          <div class="text-white text-xs font-bold tracking-wide">{item.name}</div>
          {item.desc && <div class="text-[#444] text-[10px] mt-0.5">{item.desc}</div>}
        </div>
        <div class="text-[#888] text-xs text-right self-center">{item.sm}</div>
        <div class="text-[#888] text-xs text-right self-center">{item.med}</div>
        <div class="text-[#888] text-xs text-right self-center">{item.lg}</div>
      </div>
    ))}
    <div class="text-[#333] text-[9px] tracking-[2px] uppercase mt-4 mb-2">Specialty Items</div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-x-4">
      {specialtyItems.map((item) => (
        <div class="flex justify-between py-1.5 border-b border-[#0f0f0f]">
          <span class="text-[#666] text-[10px]">{item.name}</span>
          <span class="text-[#888] text-[10px] ml-2 shrink-0">{item.price}</span>
        </div>
      ))}
    </div>
    <div class="text-[#333] text-[9px] tracking-[2px] uppercase mt-4 mb-2">Slices</div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-12">
      {slices.map((item) => (
        <div class="flex justify-between py-2 border-b border-[#0f0f0f]">
          <div>
            <div class="text-white text-xs font-bold">{item.name}</div>
            {item.desc && <div class="text-[#444] text-[10px]">{item.desc}</div>}
          </div>
          <span class="text-[#888] text-xs ml-4 self-center shrink-0">{item.price}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- ENTREES -->
  <div class="mb-12">
    <div class="flex items-center gap-4 mb-4">
      <h3 class="text-fire text-[10px] tracking-[3px] uppercase font-sans shrink-0">Entrees</h3>
      <div class="flex-1 h-px bg-[#1a1a1a]"></div>
      <span class="text-[#333] text-[9px] tracking-[1px] uppercase shrink-0">Med / Lg</span>
    </div>
    {entrees.map((item) => (
      <div class="flex justify-between py-2 border-b border-[#0f0f0f]">
        <div class="text-white text-xs font-bold tracking-wide">{item.name}</div>
        <div class="text-[#888] text-xs ml-4 shrink-0">
          {item.price ? item.price : `${item.med} / ${item.lg}`}
        </div>
      </div>
    ))}
  </div>

  <!-- SALADS -->
  <div class="mb-12">
    <div class="flex items-center gap-4 mb-4">
      <h3 class="text-fire text-[10px] tracking-[3px] uppercase font-sans shrink-0">Salads</h3>
      <div class="flex-1 h-px bg-[#1a1a1a]"></div>
      <span class="text-[#333] text-[9px] tracking-[1px] uppercase shrink-0">Med / Lg</span>
    </div>
    {salads.map((item) => (
      <div class="flex justify-between py-2 border-b border-[#0f0f0f]">
        <div class="text-white text-xs font-bold tracking-wide">{item.name}</div>
        <div class="text-[#888] text-xs ml-4 shrink-0">{item.med} / {item.lg}</div>
      </div>
    ))}
  </div>

  <!-- SANDWICHES -->
  <div class="mb-12">
    <div class="flex items-center gap-4 mb-4">
      <h3 class="text-fire text-[10px] tracking-[3px] uppercase font-sans shrink-0">Sandwiches</h3>
      <div class="flex-1 h-px bg-[#1a1a1a]"></div>
      <span class="text-[#333] text-[9px] tracking-[1px] uppercase shrink-0">Med / Lg</span>
    </div>
    {sandwiches.map((item) => (
      <div class="flex justify-between py-2 border-b border-[#0f0f0f]">
        <div class="text-white text-xs font-bold tracking-wide">{item.name}</div>
        <div class="text-[#888] text-xs ml-4 shrink-0">{item.med} / {item.lg}</div>
      </div>
    ))}
  </div>

  <!-- LUNCH SPECIALS -->
  <div class="mb-12">
    <div class="flex items-center gap-4 mb-4">
      <h3 class="text-fire text-[10px] tracking-[3px] uppercase font-sans shrink-0">Lila's Lunch Specials</h3>
      <div class="flex-1 h-px bg-[#1a1a1a]"></div>
    </div>
    <div class="text-[#444] text-[10px] tracking-[2px] uppercase mb-3">11 AM – 4 PM</div>
    {lunchSpecials.map((item) => (
      <div class="flex justify-between py-2 border-b border-[#0f0f0f]">
        <div class="text-white text-xs font-bold tracking-wide">{item.name}</div>
        <div class="text-[#888] text-xs ml-4 shrink-0">{item.price}</div>
      </div>
    ))}
  </div>

  <!-- ADD-ONS -->
  <div class="mb-12">
    <div class="flex items-center gap-4 mb-4">
      <h3 class="text-fire text-[10px] tracking-[3px] uppercase font-sans shrink-0">Add-Ons & Extras</h3>
      <div class="flex-1 h-px bg-[#1a1a1a]"></div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-12">
      {addOns.map((item) => (
        <div class="flex justify-between py-2 border-b border-[#0f0f0f]">
          <div class="text-white text-xs font-bold tracking-wide">{item.name}</div>
          <div class="text-[#888] text-xs ml-4 shrink-0">{item.price}</div>
        </div>
      ))}
    </div>
  </div>

  <!-- CATERING -->
  <div>
    <div class="flex items-center gap-4 mb-2">
      <h3 class="text-fire text-[10px] tracking-[3px] uppercase font-sans shrink-0">Catering</h3>
      <div class="flex-1 h-px bg-[#1a1a1a]"></div>
    </div>
    <div class="text-[#444] text-[10px] mb-6">Half Trays (Serves 10) · Full Trays (Serves 20)</div>

    <div class="text-[#333] text-[9px] tracking-[2px] uppercase mb-2">Entrees</div>
    <div class="grid grid-cols-[1fr_auto_auto] gap-x-8 mb-1">
      <div></div>
      <div class="text-[#333] text-[9px] tracking-[1px] uppercase text-right">Half</div>
      <div class="text-[#333] text-[9px] tracking-[1px] uppercase text-right">Full</div>
    </div>
    {cateringEntrees.map((item) => (
      <div class="grid grid-cols-[1fr_auto_auto] gap-x-8 py-2 border-b border-[#0f0f0f]">
        <div class="text-white text-xs font-bold tracking-wide">{item.name}</div>
        <div class="text-[#888] text-xs text-right self-center">{item.half}</div>
        <div class="text-[#888] text-xs text-right self-center">{item.full}</div>
      </div>
    ))}

    <div class="text-[#333] text-[9px] tracking-[2px] uppercase mt-8 mb-2">Salads</div>
    {cateringSalads.map((item) => (
      <div class="grid grid-cols-[1fr_auto_auto] gap-x-8 py-2 border-b border-[#0f0f0f]">
        <div class="text-white text-xs font-bold tracking-wide">{item.name}</div>
        <div class="text-[#888] text-xs text-right self-center">{item.half}</div>
        <div class="text-[#888] text-xs text-right self-center">{item.full}</div>
      </div>
    ))}

    <div class="text-[#333] text-[9px] tracking-[2px] uppercase mt-8 mb-2">Add-Ons</div>
    {cateringAddOns.map((item) => (
      <div class="flex justify-between py-2 border-b border-[#0f0f0f]">
        <div class="text-white text-xs font-bold tracking-wide">{item.name}</div>
        <div class="text-[#888] text-xs ml-4 shrink-0">{item.price}</div>
      </div>
    ))}
  </div>
</section>

<!-- Diamond divider -->
<div class="flex items-center px-8 py-0">
  <div class="flex-1 h-px" style="background: linear-gradient(90deg, transparent, #222)"></div>
  <div class="w-2 h-2 bg-fire mx-2 rotate-45"></div>
  <div class="flex-1 h-px" style="background: linear-gradient(90deg, #222, transparent)"></div>
</div>
