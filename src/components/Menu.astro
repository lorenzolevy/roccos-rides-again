  {
    name: 'Pizza',
    items: [
      'Plain Pie',
      'Sicilian',
      '— update with full menu items —',
    ],
  },
  {
    name: 'Entrees',
    items: [
      '— update with full menu items —',
    ],
  },
  {
    name: 'Salads',
    items: [
      '— update with full menu items —',
    ],
  },
  {
    name: 'Sandwiches',
    items: [
      '— update with full menu items —',
    ],
  },
  {
    name: 'Catering',
