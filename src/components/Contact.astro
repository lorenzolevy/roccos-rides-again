<section id="contact" class="px-8 md:px-16 py-16 bg-[#050505]">
  <div class="flex items-center gap-3 mb-4">
    <img src="/section-divider.svg" alt="" class="h-5 opacity-80" />
    <span class="text-fire text-sm tracking-[4px] uppercase">Contact</span>
  </div>
  <h2 class="font-serif font-black text-white text-2xl md:text-3xl mb-8">Book an Event</h2>

  <div class="flex flex-wrap gap-10">
    <div>
      <div class="text-[#888] text-sm tracking-[2px] uppercase mb-2">Phone</div>
      <a href="tel:3109951895" class="text-teal-400 text-lg hover:text-fire transition-colors duration-200">
        (310) 995-1895
      </a>
    </div>
    <div>
      <div class="text-[#888] text-sm tracking-[2px] uppercase mb-2">Email</div>
      <a
        href="mailto:kristina@roccosridesagain.com"
        class="text-teal text-lg hover:text-white transition-colors duration-200"
      >
        kristina@roccosridesagain.com
      </a>
    </div>
  </div>
</section>
<div class="flex items-center px-8 md:px-16 py-4">
  <div class="flex-1 h-px" style="background: linear-gradient(90deg, transparent, #2ec4b6)"></div>
  <div class="w-2.5 h-2.5 bg-teal mx-3 rotate-45 shrink-0" style="box-shadow: 0 0 10px rgba(46,196,182,0.4)"></div>
  <div class="flex-1 h-px" style="background: linear-gradient(90deg, #2ec4b6, transparent)"></div>
</div>
